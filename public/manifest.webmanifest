{
  "name": "Menuply",
  "short_name": "Menuply",
  "description": "Browse restaurant menus near you. Find dishes, deals, and nutrition insights on Menuply.",
  "id": "/?pwa=menuply-consumer-v4-browser",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "display_override": ["browser"],
  "handle_links": "not-preferred",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#1f4e3d",
  "categories": ["food", "lifestyle"],
  "icons": [
    {
      "src": "/pwa-icons/menuply-consumer-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-icons/menuply-consumer-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-icons/menuply-consumer-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
