VITE_API_BASE_URL=http://localhost:3001
VITE_SENTRY_DSN=
# Development is fixed at 100%. Reduce production sampling after investigation.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Live home is HomeNext by default. Rollback "/" to legacy discovery home:
#   VITE_USE_LEGACY_HOME=1  OR  VITE_ENABLE_NEW_HOMEPAGE=0
# Legacy home is always available at /home-legacy (no flag required).
# Required for GA4 on menuply.com / grubbid.com / *.vercel.app: must be set in Vercel
# for Production AND Preview (Vite inlines at build time).
# Production Measurement ID (verified on menuply.com 2026-07-13): G-SXN4N8W2SM
# Local .env may still use a different ID (e.g. G-KLLBC4W5XH) if targeting a separate
# GA stream/property — do not assume those IDs share property 537562785 until Admin confirms.
# Reference: docs/analytics/MENUPLY_ANALYTICS_BASELINE.md
VITE_GA_MEASUREMENT_ID=G-SXN4N8W2SM
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_APPLE_CLIENT_ID=com.grubbid.web
VITE_APPLE_REDIRECT_URI=http://localhost:5173/auth/apple/callback
