{
  "name": "menubloc-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generateBuildInfo.mjs && vite build && node scripts/prerender.mjs",
    "design-lock": "node scripts/check-design-lock.mjs && npm run verify:discovery-state-and-chip-rails",
    "verify:allergen-and-filtered-counts": "node scripts/verifyAllergenAndFilteredCounts.mjs",
    "verify:allergen-and-filtered-counts-live": "node scripts/verifyAllergenAndFilteredCountsLive.mjs",
    "verify:discovery-chips": "node scripts/verifyDiscoveryStateAndChipRails.mjs",
    "verify:discovery-state-and-chip-rails": "node scripts/verifyDiscoveryStateAndChipRails.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "smoke:homepage": "node scripts/smoke-homepage.mjs",
    "test": "node test/siteFooterNavigationContract.test.js && node --test tests/*.test.js test/manualMenuEntryModel.test.cjs && npx vitest run src/pages/__tests__/ManualMenuEntryPage.test.jsx && npm run verify:geo-routes && npm run verify:discovery-state-and-chip-rails",
    "test:menu-experience-contract": "node test/menuPurchaseWaiterHintContract.test.js && node test/consumerPreferenceFilterContract.test.js && node test/menuCatalogBrowsePreferences.test.js",
    "test:share-contract": "node --test test/shareCopyLinkModalContract.test.js test/shareCanonicalUrlContract.test.js",
    "test:food-social-contract": "node --test test/menuplyActionSheetContract.test.js test/myMenuplyFourQuestionsContract.test.js test/dinerAboutPhotosContract.test.js test/wantToEatPhotosContract.test.js test/imEatingFoodActivityContract.test.js test/inviteToEatContract.test.js test/whatIAteTodayContract.test.js test/menuItemSaveToMyMenuplyContract.test.js",
    "verify:geo-routes": "node scripts/verifyGeoRoutes.mjs",
    "verify:sitemap": "node scripts/validateSitemap.mjs",
    "verify:search-quality": "node scripts/verifyGeoRoutes.mjs",
    "ui:smoke": "npx playwright test tests/playwright/smoke.spec.js --reporter=list",
    "ui:visual": "npx playwright test tests/playwright/visual.spec.js --reporter=list",
    "ui:update-baselines": "npx playwright test tests/playwright/visual.spec.js --update-snapshots --reporter=list"
  },
  "dependencies": {
    "@sentry/react": "^10.63.0",
    "@stripe/react-stripe-js": "^6.1.0",
    "@stripe/stripe-js": "^9.0.1",
    "posthog-js": "^1.368.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.58.2",
    "vite": "^7.2.4",
    "vitest": "^4.1.9"
  }
}
